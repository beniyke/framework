<?php

declare(strict_types=1);

namespace {namespace}\Controllers;

use App\Core\BaseController;
use Helpers\Http\Response;

class {controllername} extends BaseController 
{
	/**
	 * Display a listing of the resource.
	 */
	public function index(): Response 
	{
	    if (!$this->request->isGet()) {
	        return $this->unauthorized();
	    }

		return $this->asApiResponse(true, 'Resource found');
	}

	/**
	 * Display a specific resource.
	 */
	public function fetch(): Response 
	{
	    if (!$this->request->isGet()) {
	        return $this->unauthorized();
	    }

		return $this->asApiResponse(true, 'Resource found');
	}

	/**
	 * Create a new resource.
	 * Smart Validation automatically runs if a matching RequestValidation class exists.
	 */
	public function create(): Response 
	{
	    if (!$this->request->isPost()) {
	        return $this->unauthorized();
	    }

		return $this->asApiResponse(true, 'Resource created');
	}

	/**
	 * Update an existing resource.
	 * Smart Validation automatically runs if a matching RequestValidation class exists.
	 */
	public function update(): Response 
	{
	    if (!$this->request->isPut()) {
	        return $this->unauthorized();
	    }

		return $this->asApiResponse(true, 'Resource updated');
	}

	/**
	 * Delete a resource.
	 */
	public function delete(): Response 
	{
	    if (!$this->request->isDelete()) {
	        return $this->unauthorized();
	    }

		return $this->asApiResponse(true, 'Resource deleted');
	}
}
